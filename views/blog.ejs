<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head.ejs') %>
    <title><%= blog.title %> | Blog</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <style>
        body {
            background-color: #f5f7fa;
            font-family: "Poppins", sans-serif;
        }

        /* Blog Title */
        .blog-title {
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 15px;
            color: #222;
        }

        /* Blog Header Section */
        .blog-header {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 30px;
            padding: 20px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        /* Blog Image */
        .blog-main-img {
            width: 350px;
            height: 350px;
            object-fit: contain;
            background-color: #fff;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.26);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: block;
        }

        .blog-main-img:hover {
            transform: scale(1.03);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
        }

        /* Blog Intro Text */
        .blog-intro {
            max-width: 500px;
        }

        .blog-intro h3 {
            font-size: 1.8rem;
            font-weight: bold;
            color: #222;
            margin-bottom: 10px;
        }

        .blog-intro p {
            font-size: 1rem;
            color: #555;
            line-height: 1.7;
        }

        /* Blog Body */
        .blog-body {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #333;
        }

        /* Author Section */
        .author-card {
            background: white;
            padding: 10px 15px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .author-card img {
            border-radius: 50%;
            width: 55px;
            height: 55px;
            object-fit: cover;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        /* Comments Section */
        .comment-box {
            background: #fff;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 15px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .comment-box img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            margin-right: 10px;
        }

        .comment-box strong {
            color: #222;
        }

        .no-comments {
            color: #666;
            font-style: italic;
        }

        /* Responsive Design */
        @media screen and (max-width: 992px) {
            .blog-header {
                flex-direction: column;
                text-align: center;
            }

            .blog-main-img {
                width: 300px;
                height: 300px;
            }
        }

        @media screen and (max-width: 576px) {
            .blog-main-img {
                width: 100%;
                height: auto;
                border-radius: 10px;
            }

            .blog-intro h3 {
                font-size: 1.4rem;
            }
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <%- include("./partials/nav.ejs") %>

    <!-- Blog Container -->
    <div class="container mt-4">
        <!-- Blog Title -->
        <h2 class="blog-title text-center"><%= blog.title %></h2>

        <!-- Blog Header with Image Left + Text Right -->
        <div class="blog-header">
            <!-- Blog Cover Image -->
            <img src="<%= blog.coverImageUrl %>" alt="Blog Cover Image" class="blog-main-img">

            <!-- Blog Intro Text -->
            <div class="blog-intro">
                <h3>About This Blogify Web Application</h3>
                <p>
                    Welcome to my developer journey! Here, I share 
                    insights, coding tips, creative solutions, and 
                    the exciting challenges I face while building 
                    amazing projects. I also love covering trending 
                    topics in entertainment — from movies and sports 
                    to social media buzz — keeping things fun and engaging for everyone.
                </p>
            </div>
        </div>

        <!-- Blog Body -->
        <div class="p-4 bg-white rounded shadow-sm mb-4">
            <pre style="white-space: pre-wrap; font-size: 16px; font-family: inherit;" class="blog-body">
                <%= blog.body %>
            </pre>
        </div>

        <!-- Author Info -->
        <div class="author-card mb-4">
            <img src="<%= blog.createdBy? blog.createdBy.profileImageUrl : '/images/default.png' %>" alt="Author">
            <div>
                <h5 class="mb-0 text-capitalize"><%= blog.createdBy ? blog.createdBy.fulName : 'Unknown Author' %></h5>
                <small class="text-muted">Author</small>
            </div>
        </div>

        <!-- Comments Section -->
        <div class="mt-5">
            <h3 class="mb-3">Comments</h3>

            <!-- Add Comment Form -->
            <% if (locals.user) { %>
                <form action="/blog/comment/<%= blog._id %>" method="post" class="mb-4">
                    <div class="mb-3">
                        <input 
                            type="text" 
                            class="form-control p-2" 
                            name="content" 
                            placeholder="Write a comment..." 
                            required>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
                </form>
            <% } else { %>
                <p class="text-muted">You must be logged in to comment.</p>
            <% } %>

            <!-- Display Comments -->
            <div class="mt-4">
                <% if (comments.length > 0) { %>
                    <% comments.forEach(comment => { %>
                        <div class="comment-box d-flex align-items-start">
                            <img src="<%= comment.createdBy.profileImageUrl || '/images/default.png' %>" alt="User">
                            <div>
                                <strong class="text-capitalize"><%= comment.createdBy.fulName %></strong>
                                <p class="mb-1"><%= comment.content %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="no-comments">No comments yet. Be the first to comment!</p>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('./partials/scripts.ejs') %>
</body>
</html>
